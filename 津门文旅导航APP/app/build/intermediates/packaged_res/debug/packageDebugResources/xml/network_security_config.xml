<?xml version="1.0" encoding="utf-8"?>
<!-- 开发期允许明文 HTTP，便于连接本机/局域网后端；上线前应改为 HTTPS 白名单 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
